FROM node:22-alpine
WORKDIR /usr/src/app
ARG APP_NAME
ENV APP_NAME=${APP_NAME}

# Manifiestos primero para aprovechar la caché de capas (npm workspaces)
COPY package*.json ./
COPY apps/${APP_NAME}/package.json apps/${APP_NAME}/
COPY libs/contracts/package.json libs/contracts/
COPY libs/kafka-toolkit/package.json libs/kafka-toolkit/

RUN npm install

COPY libs libs
COPY apps/${APP_NAME} apps/${APP_NAME}

# Librerías compartidas primero, después el servicio
RUN npm run build -w @activation-poc/contracts \
 && npm run build -w @activation-poc/kafka-toolkit \
 && npm run build -w @activation-poc/${APP_NAME}

WORKDIR /usr/src/app/apps/${APP_NAME}
CMD ["node", "dist/main.js"]
